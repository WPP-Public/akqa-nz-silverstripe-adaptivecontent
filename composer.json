{
    "name": "heyday/silverstripe-adaptivecontent",
    "description": "SilverStripe Adaptive Content",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "silverstripe/asset-admin": "^3",
        "silverstripe/cms": "^6",
        "symbiote/silverstripe-gridfieldextensions": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Heyday\\AdaptiveContent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Heyday\\AdaptiveContent\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "5.0.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "coverage": "vendor/bin/phpunit --coverage-text",
        "lint": "vendor/bin/phpstan analyse --memory-limit=512M",
        "lint:phpstan": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
